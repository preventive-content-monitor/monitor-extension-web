{
  "manifest_version": 3,
  "key": "",
  "name": "Guardian - Proteção Familiar",
  "version": "0.6.5",
  "description": "Proteção digital para crianças e adolescentes. Monitora e filtra conteúdo impróprio.",
  "action": {
    "default_title": "Guardian",
    "default_popup": "src/options/options.html?popup=1"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "incognito": "spanning",
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/sanitizer.js",
        "src/content/searchDetector.js",
        "src/content/pageObserver.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/webBridge.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/blocked/blocked.html",
        "src/blocked/blocked.js",
        "src/warned/warn.html",
        "src/warned/warn.js",
        "src/shared/paramsIntercepcao.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
